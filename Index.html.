.btn{display:inline-block;background:#64d7ff;color:#07111d;text-decoration:none;font-weight:bold;padding:12px 20px;border-radius:9px;margin:8px 5px 8px 0}
.btn.secondary{background:#243b55;color:#fff;border:1px solid #45627f}
.hero-img{width:100%;max-height:340px;object-fit:cover;border-radius:12px;margin-top:15px}
.grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:15px}
.tile{background:#0b1422;border:1px solid #263951;border-radius:12px;padding:16px}
footer{text-align:center;color:#8e9fb5;padding:28px 16px}
