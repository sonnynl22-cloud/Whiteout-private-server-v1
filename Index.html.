<title>Whiteout Private Server</title>
<style>
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{margin:0;background:#080d17;color:#edf4ff;font-family:Arial,sans-serif;line-height:1.7}
header{padding:65px 20px;text-align:center;background:linear-gradient(180deg,rgba(5,12,24,.45),#080d17),url('https://images.unsplash.com/photo-1517299321609-52687d1bc55a?auto=format&fit=crop&w=1400&q=85') center/cover}
header h1{font-size:clamp(34px,7vw,58px);line-height:1.15;margin:15px 0;color:#fff}
header p{color:#d0e1f5;font-size:17px}
.tag{color:#8ddcff;text-transform:uppercase;letter-spacing:3px;font-size:12px}
nav{position:sticky;top:0;background:#0d1524;border-bottom:1px solid #26364d;padding:12px;text-align:center;z-index:2}
nav a{color:#dce9f8;text-decoration:none;margin:0 9px;font-size:14px}
main{max-width:950px;margin:auto;padding:22px}
